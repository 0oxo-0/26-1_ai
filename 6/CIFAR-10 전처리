# tensorflow 라이브러리 불러오기
# 딥러닝 모델 생성 및 학습에 사용
import tensorflow as tf

# numpy 라이브러리 불러오기
# 배열 처리 및 데이터 조작에 사용
import numpy as np

# matplotlib 불러오기
# 이미지 출력 및 그래프 시각화에 사용
import matplotlib.pyplot as plt


# tensorflow.keras 안의 layers, models 모듈 불러오기
# layers: CNN 층 생성
# models: 모델 생성
from tensorflow.keras import layers, models

# CIFAR-10 데이터셋 불러오기
from tensorflow.keras.datasets import cifar10

# 원-핫 인코딩 함수
# 현재 코드에서는 사용되지 않음
from tensorflow.keras.utils import to_categorical


# =========================
# 1. CIFAR-10 데이터 로드
# =========================


# CIFAR-10 데이터셋 불러오기
# x_train: 학습 이미지
# y_train: 학습 라벨
# x_test: 테스트 이미지
# y_test: 테스트 라벨
(x_train, y_train), (x_test, y_test) = cifar10.load_data()


# CIFAR-10 클래스 번호 설명
# airplane: 0
# automobile: 1
# bird: 2
# cat: 3
# deer: 4
# dog: 5
# frog: 6
# horse: 7
# ship: 8
# truck: 9


# 고양이 클래스 번호 저장
CAT_LABEL = 3

# 개 클래스 번호 저장
DOG_LABEL = 5


# =========================
# 2. Cat / Dog 데이터만 선택
# =========================


# 학습 데이터에서
# 라벨이 cat(3) 또는 dog(5)인 데이터의 인덱스를 찾음
train_mask = np.where(
    (y_train[:, 0] == CAT_LABEL) |
    (y_train[:, 0] == DOG_LABEL)
)[0]


# 테스트 데이터에서
# 라벨이 cat(3) 또는 dog(5)인 데이터의 인덱스를 찾음
test_mask = np.where(
    (y_test[:, 0] == CAT_LABEL) |
    (y_test[:, 0] == DOG_LABEL)
)[0]


# 찾은 인덱스를 이용해
# cat/dog 학습 이미지만 추출
x_train_cd = x_train[train_mask]

# cat/dog 학습 라벨만 추출
y_train_cd = y_train[train_mask]


# cat/dog 테스트 이미지만 추출
x_test_cd = x_test[test_mask]

# cat/dog 테스트 라벨만 추출
y_test_cd = y_test[test_mask]


# =========================
# 3. 라벨 변환
# cat -> 0
# dog -> 1
# =========================


# 학습 라벨 변환
# cat이면 0
# dog이면 1
y_train_cd = np.where(
    y_train_cd[:, 0] == CAT_LABEL,
    0,
    1
)


# 테스트 라벨 변환
# cat이면 0
# dog이면 1
y_test_cd = np.where(
    y_test_cd[:, 0] == CAT_LABEL,
    0,
    1
)


# =========================
# 4. 정규화
# =========================


# 이미지 데이터를 float32 타입으로 변환 후
# 255로 나누어 0~1 범위로 정규화
x_train_cd = x_train_cd.astype("float32") / 255.0


# 테스트 데이터도 동일하게 정규화
x_test_cd = x_test_cd.astype("float32") / 255.0


# 학습 데이터 shape 출력
# 예: (10000, 32, 32, 3)
print("Train data:", x_train_cd.shape)

# 학습 라벨 shape 출력
# 예: (10000,)
print("Train label:", y_train_cd.shape)

# 테스트 데이터 shape 출력
print("Test data:", x_test_cd.shape)

# 테스트 라벨 shape 출력
print("Test label:", y_test_cd.shape)


# =========================
# 5. 데이터 확인
# =========================


# 라벨 이름 저장
# 0 -> cat
# 1 -> dog
class_names = ["cat", "dog"]


# 전체 출력 창 크기 설정
plt.figure(figsize=(10, 4))


# 학습 이미지 10개 출력
for i in range(10):

    # 2행 5열 형태로 subplot 생성
    plt.subplot(2, 5, i + 1)

    # 이미지 출력
    plt.imshow(x_train_cd[i])

    # 제목 출력
    # 라벨 숫자를 이용해 cat/dog 표시
    plt.title(class_names[y_train_cd[i]])

    # 축 제거
    plt.axis("off")


# 최종 화면 출력
plt.show()
